# 验证脚本的运行时缓存与产物，不入库
spike/uvcache/
**/__pycache__/
*.pyc

# SDE 索引库与下载缓存（构建产物，按 build 号重建，见 docs/配装理解-软件设计-v1.md §7.1）
data/

# 测试与运行产物（可重建）
.pytest_cache/
acceptance/out/

# pyfa 侦察的临时环境 / 被 Windows ACL 锁死的解包目录（不可读不可删，不影响功能）
spike/pyfa_scratch/

# 会话临时区（部署暂存、上传包），不入库
.tmp/

# skill 打包产物不入库
skill/*.zip
