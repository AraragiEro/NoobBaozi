"""统计基线字段通过率。"""
import json
import pathlib

d = json.loads(pathlib.Path("evefit/acceptance/out/acceptance-FINAL-HP.json").read_text(encoding="utf-8"))
total = sum(len(c["field_results"]) for c in d["cases"])
ok = sum(1 for c in d["cases"] for r in c["field_results"] if r["ok"])
per = len(d["cases"][0]["field_results"])
print(f"样本 {len(d['cases'])} × 字段 {per} = {total}；通过 {ok} = {ok/total:.2%}")
print("status:", d["status"], "counts:", d["counts"])
low = [x for x in d["defects"] if x["severity"] == "low"]
print(f"low 缺陷 {len(low)} 条；非 low {len(d['defects']) - len(low)} 条")
